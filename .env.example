# Copy to .env and edit:  cp .env.example .env
# Never commit your real .env file.

# --- Required ---------------------------------------------------------------
LOGIN_PASSWORD=change-me-to-a-strong-password

# --- Recommended ------------------------------------------------------------
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Optional ---------------------------------------------------------------
LOGIN_USER=admin
SESSION_HOURS=168
HOST_PORT=8080
PUID=1000
PGID=1000
TZ=Etc/UTC
TITLE=Brave
BRAVE_CLI=--disable-dev-shm-usage --no-sandbox
